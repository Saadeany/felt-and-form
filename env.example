# ── Root .env — read automatically by `docker compose` ───────────────────
# Place this file at the repo root as `.env` (same folder as docker-compose.yml).
# Docker Compose uses these to fill in the ${...} placeholders in
# docker-compose.yml. Keep these in sync with backend/.env — DB_NAME,
# DB_USER, and DB_PASSWORD must match on both sides.

DB_NAME=felt_and_form
DB_USER=felt_user
DB_PASSWORD=CHANGE_ME_use_a_long_random_password
DB_ROOT_PASSWORD=CHANGE_ME_another_long_random_password
